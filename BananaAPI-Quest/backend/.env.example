# Partly generated with AI assistance, reviewed and modified by me.
# BananaAPI-Quest: Environment Configuration Template
# Duplicate this file as .env and populate with your local values.

# Server Port
PORT=5000

# Security: JWT Signing Secret (must be at least 16 characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_16_chars

# Database: MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/bananaapi_quest

# CORS: Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5501,http://127.0.0.1:5501

# Banana API External Service URL
BANANA_API_URL=https://marcconrad.com/uob/banana/api.php?out=json&base64=no

# External API Timeout (milliseconds)
API_TIMEOUT=10000

# Max Retry Attempts for External API
MAX_RETRY_ATTEMPTS=3
